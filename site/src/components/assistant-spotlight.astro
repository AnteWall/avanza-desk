---
import type { ImageMetadata } from "astro";

import WindowFrame from "./window-frame.astro";
import { PROVIDERS } from "../lib/assistant";
import { url } from "../lib/url";

// The assistant gets its own section: it's the feature that ties every other page together.
interface Props {
  image: ImageMetadata;
}
const { image } = Astro.props;

const steps = [
  {
    title: "Ask from anywhere",
    text: "Press Ctrl J, or right-click any table row, chart or headline and choose Ask. It already knows the page, account and instrument you're looking at, and @ adds more.",
  },
  {
    title: "It reads the app first",
    text: "More than 30 read-only tools over the same data you see: holdings, returns against the index, fund look-through, order books, news, dividends and your trades. Web search only fills in what Avanza doesn't have, and you can turn it off.",
  },
  {
    title: "Answers you can click",
    text: "Charts are drawn live from Avanza data, not by the model, and every instrument it names is a chip that opens it in the workspace.",
  },
  {
    title: "Act on it in one click",
    text: "Send suggested target weights straight to Rebalance, then open the orders in Avanza. Anything it names opens in the app, a right-click from Add to basket or Alert me.",
  },
];
---

<section id="assistant" class="relative overflow-hidden border-y border-border/60">
  <div class="glow pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="inline-flex items-center gap-2 text-xs font-semibold tracking-wider text-brand uppercase">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.94 14.06 3 21M14 4l1.5 3.5L19 9l-3.5 1.5L14 14l-1.5-3.5L9 9l3.5-1.5Z"/></svg>
        AI assistant
      </p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
        Ask your portfolio anything
      </h2>
      <p class="mt-5 text-lg text-pretty text-muted-foreground">
        "Am I beating the index this year, and what would diversify me?" The assistant reads your holdings, runs the
        numbers with the app's own tools and answers in plain words, with charts you can hover and instruments you can
        open.
      </p>
    </div>

    <div class="mt-14" data-reveal>
      <WindowFrame src={image} alt="The AvanzaDesk assistant answering a question about the portfolio next to the workspace" title="Assistant" />
    </div>

    <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        steps.map((s, i) => (
          <li class="rounded-lg border border-border bg-card p-5">
            <span class="num text-xs font-semibold text-brand">0{i + 1}</span>
            <h3 class="mt-2 font-semibold">{s.title}</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-muted-foreground" data-reveal>
      <span>Bring your own:</span>
      {
        PROVIDERS.map((p) => (
          <span class="inline-flex h-8 items-center gap-2 rounded-full border border-border bg-card pr-3 pl-1.5 text-xs text-foreground">
            <img src={p.logo.src} alt="" width="20" height="20" class="size-5 rounded-full bg-muted p-0.5" />
            {p.name}
          </span>
        ))
      }
      <span>· Off until you connect one · Read-only</span>
    </div>
    <div class="mt-8 text-center" data-reveal>
      <a class="text-sm font-medium text-brand hover:underline" href={url("assistant/")}>Everything the assistant can do →</a>
    </div>
  </div>
</section>
