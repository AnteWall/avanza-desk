---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// A screenshot in a flat app window: border, title strip, no chrome beyond that.
interface Props {
  src: ImageMetadata;
  alt: string;
  title?: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, title = "AvanzaDesk", eager = false, class: className = "" } = Astro.props;
---

<figure class:list={["overflow-hidden rounded-lg border border-border bg-card shadow-float", className]}>
  <div class="flex h-8 items-center gap-1.5 border-b border-border bg-muted/40 px-3">
    <span class="size-2.5 rounded-full bg-border"></span>
    <span class="size-2.5 rounded-full bg-border"></span>
    <span class="size-2.5 rounded-full bg-border"></span>
    <span class="mx-auto pr-10 text-xs text-muted-foreground">{title}</span>
  </div>
  <Image
    src={src}
    alt={alt}
    widths={[640, 1200, 2000]}
    sizes="(min-width: 1152px) 1152px, 100vw"
    loading={eager ? "eager" : "lazy"}
    class="block h-auto w-full"
  />
</figure>
