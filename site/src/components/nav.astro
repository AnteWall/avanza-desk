---
import Wordmark from "./wordmark.astro";
import { REPO, stars } from "../lib/release";
import { url } from "../lib/url";

const links = [
  { href: url("#features"), label: "Features" },
  { href: url("assistant/"), label: "Assistant" },
  { href: url("#privacy"), label: "Privacy" },
  { href: url("#start"), label: "Get started" },
  { href: url("changelog/"), label: "Changelog" },
];
const starCount = await stars();
---

<header class="material sticky top-0 z-50 border-b border-border/60">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-8 px-4 sm:px-6">
    <Wordmark />
    <ul class="hidden items-center gap-6 text-sm text-muted-foreground md:flex">
      {links.map((l) => <li><a class="transition-colors hover:text-foreground" href={l.href}>{l.label}</a></li>)}
    </ul>
    <div class="ml-auto flex items-center gap-2">
      <a
        href={`https://github.com/${REPO}`}
        aria-label={`Star AvanzaDesk on GitHub${starCount === undefined ? "" : `, ${starCount} stars`}`}
        class="group hidden h-8 items-center overflow-hidden rounded-md border border-border text-sm transition-colors hover:border-muted-foreground/50 sm:inline-flex"
      >
        <span class="flex h-full items-center gap-2 px-3 text-muted-foreground transition-colors group-hover:bg-muted group-hover:text-foreground">
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          <svg class="size-3.5 transition-colors group-hover:fill-warning group-hover:text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M11.5 2.3a.6.6 0 0 1 1 0l2.8 5.7 6.3.9a.6.6 0 0 1 .3 1l-4.5 4.4 1 6.3a.6.6 0 0 1-.8.6L12 18.3l-5.6 2.9a.6.6 0 0 1-.8-.6l1-6.3L2.1 10a.6.6 0 0 1 .3-1l6.3-.9Z"/></svg>
          Star
        </span>
        {starCount !== undefined && <span data-stars class="num flex h-full items-center border-l border-border px-2.5 text-xs font-medium">{starCount.toLocaleString("sv-SE")}</span>}
      </a>
      <a
        href={url("#download")}
        class="inline-flex h-8 items-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground transition-transform active:scale-[0.97]"
      >
        Download
      </a>
    </div>
  </nav>
</header>

<script>
  // The build-time count is a fallback; this keeps it live between builds.
  fetch("https://api.github.com/repos/AnteWall/avanza-desk")
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then(({ stargazers_count: n }: { stargazers_count: number }) => {
      for (const el of document.querySelectorAll("[data-stars]")) el.textContent = n.toLocaleString("sv-SE");
    })
    .catch(() => {});
</script>
