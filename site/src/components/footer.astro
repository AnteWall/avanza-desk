---
import Wordmark from "./wordmark.astro";
import { REPO } from "../lib/release";
import { url } from "../lib/url";

const gh = `https://github.com/${REPO}`;
const columns = [
  {
    title: "Product",
    links: [
      { href: url("#features"), label: "Features" },
      { href: url("assistant/"), label: "AI assistant" },
      { href: url("#download"), label: "Download" },
      { href: url("changelog/"), label: "Changelog" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: gh, label: "Source code" },
      { href: `${gh}/issues`, label: "Report a bug" },
      { href: `${gh}/discussions`, label: "Suggest a feature" },
    ],
  },
  {
    title: "Built on",
    links: [
      { href: "https://github.com/AnteWall/avanza-ts", label: "avanza-ts" },
      { href: "https://tauri.app", label: "Tauri" },
      { href: "https://tanstack.com", label: "TanStack" },
    ],
  },
];
---

<footer class="border-t border-border/60 bg-card">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="space-y-3">
      <Wordmark />
      <p class="max-w-xs text-sm text-muted-foreground">
        A free, open-source desktop terminal for your Avanza account. Licensed AGPL-3.0.
      </p>
    </div>
    {
      columns.map((c) => (
        <div>
          <h3 class="text-xs font-semibold tracking-wider uppercase">{c.title}</h3>
          <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
            {c.links.map((l) => (
              <li>
                <a class="transition-colors hover:text-foreground" href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-border/60">
    <p class="mx-auto max-w-6xl px-4 py-6 text-xs leading-relaxed text-muted-foreground sm:px-6">
      AvanzaDesk is an independent, unofficial project. It is not affiliated with, endorsed by or supported by
      Avanza Bank AB. "Avanza" is a trademark of its owner. The app uses Avanza's private APIs, which may change or
      break without notice. Nothing in the app is investment advice: data, estimates, alerts and AI answers may be
      delayed, incomplete or wrong. You use AvanzaDesk entirely at your own risk.{" "}
      <a class="underline underline-offset-2 hover:text-foreground" href={`${gh}#disclaimer`}>Full disclaimer</a>.
    </p>
  </div>
</footer>
