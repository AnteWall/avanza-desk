---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import SectionHeading from "./section-heading.astro";

// The same screen in both themes, split along a diagonal you can drag (or move with the arrow
// keys: the range input is the accessible control, the line and knob only show it).
interface Props {
  dark: ImageMetadata;
  light: ImageMetadata;
  alt: string;
}
const { dark, light, alt } = Astro.props;
const [d, l] = await Promise.all([
  getImage({ src: dark, width: 2000, format: "webp" }),
  getImage({ src: light, width: 2000, format: "webp" }),
]);
---

<section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
  <SectionHeading
    kicker="Light and dark"
    title="Easy on the eyes, day or night"
    lede="Every color comes from Avanza's own palette and passes contrast checks in both themes. Drag the line to compare."
  />

  <div
    class="theme-split group relative mt-14 overflow-hidden rounded-lg border border-border shadow-float select-none"
    style="--split: 50"
    data-reveal
  >
    <img src={d.src} alt={`${alt}, dark theme`} width={dark.width} height={dark.height} loading="lazy" class="block h-auto w-full" />
    <img
      src={l.src}
      alt={`${alt}, light theme`}
      width={light.width}
      height={light.height}
      loading="lazy"
      class="split-light absolute inset-0 block h-full w-full"
    />
    <svg class="pointer-events-none absolute inset-0 size-full" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <line class="split-line" stroke="var(--brand)" stroke-width="2" vector-effect="non-scaling-stroke"></line>
    </svg>
    <span
      class="split-knob pointer-events-none absolute top-1/2 flex size-10 -translate-1/2 items-center justify-center rounded-full border-2 border-brand bg-background text-brand shadow-float transition-transform group-active:scale-95"
      aria-hidden="true"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6"/></svg>
    </span>
    <span class="pointer-events-none absolute bottom-10 left-4 rounded-full border border-border bg-popover px-3 py-1 text-xs font-medium shadow-float">Dark</span>
    <span class="pointer-events-none absolute right-4 bottom-10 rounded-full border border-black/10 bg-white px-3 py-1 text-xs font-medium text-black shadow-float">Light</span>
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Move the split between the dark and light theme"
      class="absolute inset-0 size-full cursor-ew-resize opacity-0"
    />
  </div>
</section>

<style>
  /* The light image shows right of a line slanted SLANT % of the width from top to bottom. */
  .theme-split {
    --slant: 8;
  }
  .split-light {
    clip-path: polygon(
      calc((var(--split) + var(--slant)) * 1%) 0,
      100% 0,
      100% 100%,
      calc((var(--split) - var(--slant)) * 1%) 100%
    );
  }
  .split-knob {
    left: calc(var(--split) * 1%);
  }
  .theme-split:has(input:focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 4px;
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(".theme-split")) {
    const input = root.querySelector("input")!;
    const line = root.querySelector(".split-line")!;
    const slant = 8;
    const set = (value: number) => {
      root.style.setProperty("--split", String(value));
      line.setAttribute("x1", String(value + slant));
      line.setAttribute("y1", "0");
      line.setAttribute("x2", String(value - slant));
      line.setAttribute("y2", "100");
    };
    set(Number(input.value));
    input.addEventListener("input", () => set(Number(input.value)));
  }
</script>
