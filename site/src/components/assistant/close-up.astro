---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

// A cropped part of the app (a menu, a chat answer): a flat frame, no window chrome.
interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: className = "" } = Astro.props;
---

<figure class:list={["overflow-hidden rounded-lg border border-border bg-card shadow-float", className]}>
  <Image src={src} alt={alt} widths={[480, 960, src.width]} sizes="(min-width: 1024px) 600px, 100vw" class="block h-auto w-full" />
</figure>
