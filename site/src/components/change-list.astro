---
import type { Change } from "../lib/changelog";

interface Props {
  changes: Change[];
}
const { changes } = Astro.props;
---

<ul class="space-y-2.5">
  {
    changes.map((c) => (
      <li class="flex items-baseline gap-3 text-sm">
        {c.scope ? (
          <span class="w-24 shrink-0 text-xs font-medium text-muted-foreground">{c.scope}</span>
        ) : (
          <span class="w-24 shrink-0" />
        )}
        <span>{c.text}</span>
      </li>
    ))
  }
</ul>
