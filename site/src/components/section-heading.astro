---
interface Props {
  kicker: string;
  title: string;
  lede?: string;
}
const { kicker, title, lede } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center" data-reveal>
  <p class="text-xs font-semibold tracking-wider text-brand uppercase">{kicker}</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
  {lede && <p class="mt-4 text-lg text-pretty text-muted-foreground">{lede}</p>}
</div>
