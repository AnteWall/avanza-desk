---
import ChangeList from "../../components/change-list.astro";
import Base from "../../layouts/base.astro";
import { formatDay } from "../../lib/format";
import { releases } from "../../lib/releases";
import { url } from "../../lib/url";
---

<Base title="Changelog · AvanzaDesk" description="What changed in each AvanzaDesk release.">
  <section class="relative overflow-hidden">
    <div class="glow pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-4xl px-4 pt-20 pb-12 sm:px-6">
      <p class="text-xs font-semibold tracking-wider text-brand uppercase">Changelog</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">What's new in AvanzaDesk</h1>
      <p class="mt-4 text-lg text-muted-foreground">
        Every release, written for the people who use it. The app shows the same notes after it updates.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
    <ol class="relative border-l border-border">
      {
        releases.map((r, i) => (
          <li class="relative pb-14 pl-8 last:pb-0 md:grid md:grid-cols-[10rem_1fr] md:gap-8 md:pl-10" id={`v${r.version}`}>
            <span class:list={["absolute top-1.5 -left-[5px] size-2.5 rounded-full ring-4 ring-background", i === 0 ? "bg-brand" : "bg-border"]} />
            <div class="md:sticky md:top-20 md:self-start">
              <a href={`#v${r.version}`} class="num text-xl font-semibold hover:text-brand">v{r.version}</a>
              {r.date && <p class="mt-1 text-xs text-muted-foreground">{formatDay(r.date)}</p>}
            </div>
            <div class="mt-4 space-y-6 md:mt-0">
              {r.sections.map((s) => (
                <div>
                  <h2 class:list={["mb-3 text-xs font-semibold tracking-wider uppercase", s.title === "Fixed" ? "text-muted-foreground" : "text-brand"]}>
                    {s.title}
                  </h2>
                  <ChangeList changes={s.changes} />
                </div>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
    <a class="mt-16 inline-block text-sm font-medium text-brand hover:underline" href={url("#download")}>Download the latest version →</a>
  </div>
</Base>
